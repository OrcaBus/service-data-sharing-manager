{
  "QueryLanguage": "JSONata",
  "StartAt": "Find matching Jobs for instrument run",
  "States": {
    "Find matching Jobs for instrument run": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__find_matching_jobs_for_run_lambda_function_arn__}",
        "Payload": {
          "instrumentRunId": "{% $states.input.instrumentRunId %}",
          "jobsConfigBucket": "${__jobs_config_bucket__}",
          "jobsConfigKey": "${__jobs_config_key__}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Output": "{% $merge([$states.input, $states.result.Payload]) %}",
      "Next": "Matching Jobs Found in Run?"
    },
    "Matching Jobs Found in Run?": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.matchingJobsFound %}",
          "Next": "Map"
        }
      ],
      "Default": "Skip"
    },
    "Map": {
      "Type": "Map",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Run autoPackage",
        "States": {
          "Run autoPackage": {
            "Type": "Task",
            "Resource": "arn:aws:states:::states:startExecution.sync:2",
            "Arguments": {
              "StateMachineArn": "${__auto_package_sfn_arn__}",
              "Input": {
                "jobName": "{% $states.input.jobName %}",
                "packageName": "{% $states.input.packageName %}",
                "packageRequest": "{% $states.input.packageRequest %}",
                "shareDestination": "{% $states.input.shareDestination %}"
              }
            },
            "Retry": [
              {
                "ErrorEquals": ["States.Timeout", "States.TaskFailed"],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "End": true
          }
        }
      },
      "End": true,
      "Items": "{% $states.input.jobList%}"
    },
    "Skip": {
      "Type": "Succeed"
    }
  }
}
