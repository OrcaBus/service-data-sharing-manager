{
  "QueryLanguage": "JSONata",
  "StartAt": "Set vars",
  "TimeoutSeconds": 86400,
  "States": {
    "Set vars": {
      "Type": "Pass",
      "Next": "Verify Slack Request",
      "Assign": {
        "slackBody": "{% $states.input.slackBody %}",
        "headers": "{% $states.input.headers %}"
      },
      "Output": {}
    },
    "Verify Slack Request": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__verify_slack_request_lambda_function_arn__}",
        "Payload": {
          "slackBody": "{% $slackBody %}",
          "headers": "{% $headers %}"
        }
      },
      "Assign": {
        "slackVerified": "{% $states.result.Payload.verified %}"
      },
      "Output": {},
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Is Slack Request Verified?"
    },
    "Is Slack Request Verified?": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $slackVerified = false  %}",
          "Next": "Slack not Verified"
        }
      ],
      "Default": "Extract Slack Action Context"
    },
    "Slack not Verified": {
      "Type": "Fail",
      "Error": "SlackNotVerified",
      "Cause": "Slack signature verification failed"
    },
    "Extract Slack Action Context": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__extract_slack_action_context_lambda_function_arn__}",
        "Payload": {
          "slackBody": "{% $slackBody %}"
        }
      },
      "Assign": {
        "actionId": "{% $states.result.Payload.actionId %}",
        "userId": "{% $states.result.Payload.userId %}",
        "channelId": "{% $states.result.Payload.channelId %}",
        "packageId": "{% $states.result.Payload.packageId %}",
        "packageName": "{% $states.result.Payload.packageName %}",
        "shareDestination": "{% $states.result.Payload.shareDestination %}",
        "jobName": "{% $states.result.Payload.jobName %}",
        "packageReadyMessageTs": "{% $states.result.Payload.packageReadyMessageTs %}",
        "mainMessageTs": "{% $states.result.Payload.mainMessageTs %}",
        "userAllowed": "{% $states.result.Payload.userAllowed %}"
      },
      "Output": {},
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Is an authorized user?"
    },
    "Is an authorized user?": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $userAllowed = false %}",
          "Next": "Notify Slack: Action Not Authorised"
        }
      ],
      "Default": "Which action?"
    },
    "Which action?": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $actionId = 'auto_deprecate_package' %}",
          "Next": "Deprecate Package"
        }
      ],
      "Default": "Notify Slack: Push Triggered"
    },
    "Notify Slack: Push Triggered": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__notify_slack_lambda_function_arn__}",
        "Payload": {
          "slackNotificationType": "PUSH_TRIGGERED",
          "jobName": "{% $jobName %}",
          "packageId": "{% $packageId %}",
          "packageName": "{% $packageName %}",
          "shareDestination": "{% $shareDestination %}",
          "userId": "{% $userId %}",
          "channelId": "{% $channelId %}",
          "mainMessageTs": "{% $mainMessageTs %}",
          "packageReadyMessageTs": "{% $packageReadyMessageTs %}"
        }
      },
      "Output": {},
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Request Push (Sync)"
    },
    "Notify Slack: Action Not Authorised": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__notify_slack_lambda_function_arn__}",
        "Payload": {
          "slackNotificationType": "PUSH_NOT_AUTHORISED",
          "userId": "{% $userId %}",
          "channelId": "{% $channelId %}",
          "mainMessageTs": "{% $mainMessageTs %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    },
    "Request Push (Sync)": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents.waitForTaskToken",
      "Arguments": {
        "Entries": [
          {
            "Detail": {
              "taskToken": "{% $states.context.Task.Token %}",
              "detailType": "${__push_sync_detail_type__}",
              "payload": {
                "packageId": "{% $packageId %}",
                "shareDestination": "{% $shareDestination %}"
              }
            },
            "DetailType": "${__push_sync_detail_type__}",
            "EventBusName": "${__event_bus_name__}",
            "Source": "${__stack_source__}"
          }
        ]
      },
      "HeartbeatSeconds": 3600,
      "Assign": {
        "pushId": "{% $states.result.id %}",
        "pushStatus": "{% $states.result.status %}",
        "errorCause": null,
        "stepsS3CopyBucket": "${__aws_s3_copy_steps_bucket__}",
        "stepsS3CopyBasePrefix": "{% '${__aws_s3_copy_steps_prefix__}' & '${__aws_s3_copy_steps_midfix__}' %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": {
            "pushStatus": "FAILED",
            "errorCause": "{% $states.errorOutput.Cause %}",
            "pushId": null,
            "stepsS3CopyBucket": null,
            "stepsS3CopyBasePrefix": null
          },
          "Next": "NotifySlack: Push Completed"
        }
      ],
      "Next": "NotifySlack: Push Completed"
    },
    "NotifySlack: Push Completed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__notify_slack_lambda_function_arn__}",
        "Payload": {
          "slackNotificationType": "PUSH_COMPLETED",
          "pushId": "{% $pushId %}",
          "stepsS3CopyBucket": "{% $stepsS3CopyBucket %}",
          "stepsS3CopyBasePrefix": "{% $stepsS3CopyBasePrefix %}",
          "pushStatus": "{% $pushStatus %}",
          "errorCause": "{% $errorCause %}",
          "packageName": "{% $packageName %}",
          "packageId": "{% $packageId %}",
          "shareDestination": "{% $shareDestination %}",
          "userId": "{% $userId %}",
          "channelId": "{% $channelId %}",
          "jobName": "{% $jobName %}",
          "mainMessageTs": "{% $mainMessageTs %}",
          "packageReadyMessageTs": "{% $packageReadyMessageTs %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    },
    "Deprecate Package": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__deprecate_package_lambda_function_arn__}",
        "Payload": {
          "packageId": "{% $packageId %}"
        }
      },
      "Assign": {
        "deprecated": "{% $states.result.Payload.deprecated %}",
        "alreadyDeprecated": "{% $states.result.Payload.alreadyDeprecated %}",
        "errorCause": "{% $states.result.Payload.errorCause %}"
      },
      "Output": {},
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Was deprecation successful?"
    },
    "Was deprecation successful?": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $deprecated = true %}",
          "Next": "Notify Slack: Package Deprecated"
        }
      ],
      "Default": "Notify Slack: Deprecate Not Successful"
    },
    "Notify Slack: Package Deprecated": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__notify_slack_lambda_function_arn__}",
        "Payload": {
          "slackNotificationType": "PACKAGE_DEPRECATED",
          "jobName": "{% $jobName %}",
          "packageId": "{% $packageId %}",
          "packageName": "{% $packageName %}",
          "shareDestination": "{% $shareDestination %}",
          "userId": "{% $userId %}",
          "channelId": "{% $channelId %}",
          "mainMessageTs": "{% $mainMessageTs %}",
          "packageReadyMessageTs": "{% $packageReadyMessageTs %}",
          "alreadyDeprecated": "{% $alreadyDeprecated %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    },
    "Notify Slack: Deprecate Not Successful": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__notify_slack_lambda_function_arn__}",
        "Payload": {
          "slackNotificationType": "DEPRECATE_NOT_SUCCESSFUL",
          "userId": "{% $userId %}",
          "channelId": "{% $channelId %}",
          "mainMessageTs": "{% $mainMessageTs %}",
          "errorCause": "{% $errorCause %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    }
  }
}
