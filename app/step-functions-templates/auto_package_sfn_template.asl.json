{
  "QueryLanguage": "JSONata",
  "StartAt": "Set vars",
  "TimeoutSeconds": 86400,
  "States": {
    "Set vars": {
      "Type": "Pass",
      "Next": "Request Package (Sync)",
      "Assign": {
        "jobName": "{% $states.input.jobName %}",
        "packageName": "{% $states.input.packageName %}",
        "packageRequest": "{% $states.input.packageRequest %}",
        "shareDestination": "{% $states.input.shareDestination %}"
      },
      "Output": {}
    },
    "Request Package (Sync)": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents.waitForTaskToken",
      "Arguments": {
        "Entries": [
          {
            "Detail": {
              "taskToken": "{% $states.context.Task.Token %}",
              "detailType": "${__packaging_sync_detail_type__}",
              "payload": {
                "packageName": "{% $packageName %}",
                "packageRequest": "{% $packageRequest %}"
              }
            },
            "DetailType": "${__packaging_sync_detail_type__}",
            "EventBusName": "${__event_bus_name__}",
            "Source": "${__stack_source__}"
          }
        ]
      },
      "HeartbeatSeconds": 3600,
      "Assign": {
        "id": "{% $states.result.id %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Auto Package Failed"
        }
      ],
      "Next": "Notify Slack: Packaging Complete"
    },
    "Notify Slack: Packaging Complete": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__notify_slack_lambda_function_arn__}",
        "Payload": {
          "jobName": "{% $jobName %}",
          "packageId": "{% $id %}",
          "packageName": "{% $packageName %}",
          "shareDestination": "{% $shareDestination %}",
          "slackNotificationType": "PACKAGE_READY"
        }
      },
      "Assign": {
        "channelId": "{% $states.result.Payload.channelId %}",
        "mainMessageTs": "{% $states.result.Payload.mainMessageTs %}",
        "packageReadyMessageTs": "{% $states.result.Payload.packageReadyMessageTs %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Schedule Package Expiry",
      "Output": {}
    },
    "Schedule Package Expiry": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:scheduler:createSchedule",
      "Arguments": {
        "Name": "{% '${__stack_prefix__}' & '-package-expiry-' & $id %}",
        "GroupName": "default",
        "ActionAfterCompletion": "DELETE",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "ScheduleExpression": "{% 'at(' & $fromMillis($toMillis($now()) + ${__package_expiry_days__} * 24 * 60 * 60 * 1000, '[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]') & ')' %}",
        "Target": {
          "Arn": "${__notify_slack_lambda_function_arn__}",
          "RoleArn": "${__package_expiry_scheduler_role_arn__}",
          "Input": "{% $string({ 'slackNotificationType': 'PACKAGE_EXPIRED', 'jobName': $jobName, 'packageId': $id, 'packageName': $packageName, 'shareDestination': $shareDestination, 'channelId': $channelId, 'mainMessageTs': $mainMessageTs, 'packageReadyMessageTs': $packageReadyMessageTs }) %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Auto Package Succeeded",
      "Output": {}
    },
    "Auto Package Succeeded": {
      "Type": "Succeed"
    },
    "Auto Package Failed": {
      "Type": "Fail"
    }
  }
}
