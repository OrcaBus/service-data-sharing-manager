{
  "QueryLanguage": "JSONata",
  "StartAt": "Set vars",
  "TimeoutSeconds": 86400,
  "States": {
    "Set vars": {
      "Type": "Pass",
      "Next": "Verify Slack Request",
      "Assign": {
        "slackBody": "{% $states.input.slackBody %}",
        "headers": "{% $states.input.headers %}"
      },
      "Output": {}
    },
    "Verify Slack Request": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__verify_slack_request_lambda_function_arn__}",
        "Payload": {
          "slackBody": "{% $slackBody %}",
          "headers": "{% $headers %}"
        }
      },
      "Assign": {
        "slackVerified": "{% $states.result.Payload.verified %}"
      },
      "Output": {},
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Is Slack Request Verified?"
    },
    "Is Slack Request Verified?": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $slackVerified = false  %}",
          "Next": "Slack not Verified"
        }
      ],
      "Default": "Extract Slack Action Context"
    },
    "Slack not Verified": {
      "Type": "Fail",
      "Error": "SlackNotVerified",
      "Cause": "Slack signature verification failed"
    },
    "Extract Slack Action Context": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__extract_slack_action_context_lambda_function_arn__}",
        "Payload": {
          "slackBody": "{% $slackBody %}"
        }
      },
      "Assign": {
        "userId": "{% $states.result.Payload.userId %}",
        "channelId": "{% $states.result.Payload.channelId %}",
        "packageId": "{% $states.result.Payload.packageId %}",
        "packageName": "{% $states.result.Payload.packageName %}",
        "shareDestination": "{% $states.result.Payload.shareDestination %}",
        "jobName": "{% $states.result.Payload.jobName %}",
        "packageReadyMessageTs": "{% $states.result.Payload.packageReadyMessageTs %}",
        "mainMessageTs": "{% $states.result.Payload.mainMessageTs %}"
      },
      "Output": {
        "userAllowed": "{% $states.result.Payload.userAllowed %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Is an authorized user?"
    },
    "Is an authorized user?": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.userAllowed = false %}",
          "Next": "Notify Slack: Push Not Authorised"
        }
      ],
      "Default": "Notify Slack: Push Triggered"
    },
    "Notify Slack: Push Triggered": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__notify_slack_lambda_function_arn__}",
        "Payload": {
          "slackNotificationType": "PUSH_TRIGGERED",
          "jobName": "{% $jobName %}",
          "packageId": "{% $packageId %}",
          "packageName": "{% $packageName %}",
          "shareDestination": "{% $shareDestination %}",
          "userId": "{% $userId %}",
          "channelId": "{% $channelId %}",
          "mainMessageTs": "{% $mainMessageTs %}",
          "packageReadyMessageTs": "{% $packageReadyMessageTs %}"
        }
      },
      "Output": {},
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Trigger Push"
    },
    "Notify Slack: Push Not Authorised": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__notify_slack_lambda_function_arn__}",
        "Payload": {
          "slackNotificationType": "PUSH_NOT_AUTHORISED",
          "userId": "{% $userId %}",
          "channelId": "{% $channelId %}",
          "mainMessageTs": "{% $mainMessageTs %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    },
    "Trigger Push": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__trigger_push_lambda_function_arn__}",
        "Payload": {
          "packageId": "{% $packageId %}",
          "shareDestination": "{% $shareDestination %}"
        }
      },
      "Output": {
        "id": "{% $states.result.Payload.pushRequestObject.id %}",
        "status": "{% $states.result.Payload.pushRequestObject.status %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Wait For Push"
    },
    "Wait For Push": {
      "Type": "Wait",
      "Seconds": 300,
      "Next": "Check Push Status"
    },
    "Check Push Status": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__check_package_push_status_lambda_function_arn__}",
        "Payload": {
          "id": "{% $states.input.id %}"
        }
      },
      "Output": {
        "id": "{% $states.input.id %}",
        "status": "{% $states.result.Payload.status %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Is Push Completed"
    },
    "Is Push Completed": {
      "Type": "Choice",
      "Choices": [
        {
          "Comment": "Push reached a terminal state: Succeeded, Failed, or Cancelled",
          "Condition": "{% $states.input.status in [ 'SUCCEEDED', 'FAILED', 'CANCELLED' ] %}",
          "Next": "NotifySlack: Push Completed"
        }
      ],
      "Default": "Wait For Push"
    },
    "NotifySlack: Push Completed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${__notify_slack_lambda_function_arn__}",
        "Payload": {
          "slackNotificationType": "PUSH_COMPLETED",
          "pushId": "{% $states.input.id %}",
          "status": "{% $states.input.status %}",
          "packageName": "{% $packageName %}",
          "packageId": "{% $packageId %}",
          "shareDestination": "{% $shareDestination %}",
          "userId": "{% $userId %}",
          "channelId": "{% $channelId %}",
          "jobName": "{% $jobName %}",
          "mainMessageTs": "{% $mainMessageTs %}",
          "packageReadyMessageTs": "{% $packageReadyMessageTs %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    }
  }
}
